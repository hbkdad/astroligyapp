{
  "name": "personal-cosmic-calendar",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:feedback-worker": "node scripts/build-auth-email-feedback-worker.mjs",
    "start": "next start",
    "start:standalone": "node scripts/validate-runtime-config.mjs && node .next/standalone/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "node scripts/test-database.mjs",
    "test:runtime": "node scripts/test-runtime-container.mjs",
    "scan:runtime": "node scripts/scan-runtime-image.mjs",
    "test:artifact": "node scripts/test-release-artifact.mjs",
    "test:feedback-worker-artifact": "node scripts/test-feedback-worker-artifact.mjs",
    "test:infrastructure": "node scripts/test-infrastructure.mjs",
    "worker:feedback:local": "node --experimental-strip-types scripts/run-auth-email-feedback-worker-local.mts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "release:check": "npm run check && npm run test:coverage && npm run db:check && npm run test:database && npm audit --omit=dev --audit-level=high && npm run test:infrastructure && npm run test:artifact && npm run test:feedback-worker-artifact"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1108.0",
    "@aws-sdk/client-sqs": "3.1108.0",
    "@paddle/paddle-node-sdk": "3.10.0",
    "astronomy-engine": "2.1.19",
    "better-auth": "1.6.27",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.0.0",
    "vitest": "4.1.10"
  }
}
