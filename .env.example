# Server-only PostgreSQL connection string. Never expose this as NEXT_PUBLIC_*.
DATABASE_URL=postgresql://cosmic:replace-me@127.0.0.1:5432/cosmic

# Server-only canonical public origin. Indexing stays fail-closed until both values are
# deliberately configured for the verified HTTPS production host.
PUBLIC_SITE_ORIGIN=https://replace.example
PUBLIC_SITE_INDEXING_ENABLED=false

# Separate server-only LOGIN executor URLs provisioned outside migrations. Grant each login
# only the checked-in NOLOGIN roles required by that workflow; never enable LOGIN on the
# NOLOGIN roles. The account executor needs app_auth_account_bootstrap,
# app_auth_account_resolver, app_account_deletion, and app_user membership but no direct
# table grants. app_account_deletion remains execute-only on the reviewed erasure function.
BETTER_AUTH_DATABASE_URL=postgresql://auth_http_executor:replace-me@127.0.0.1:5432/cosmic
AUTH_ACCOUNT_DATABASE_URL=postgresql://auth_account_executor:replace-me@127.0.0.1:5432/cosmic
AUTH_CONTACT_DATABASE_URL=postgresql://auth_contact_executor:replace-me@127.0.0.1:5432/cosmic
AUTH_EMAIL_DATABASE_URL=postgresql://auth_email_executor:replace-me@127.0.0.1:5432/cosmic
AUTH_EMAIL_FEEDBACK_DATABASE_URL=postgresql://auth_feedback_executor:replace-me@127.0.0.1:5432/cosmic

# Current key first, then decryption-only prior keys: version:secret,version:secret.
BETTER_AUTH_SECRETS=1:replace-with-at-least-32-random-characters
BETTER_AUTH_BASE_URL=https://replace.example
BETTER_AUTH_TRUSTED_ORIGINS=https://replace.example
BETTER_AUTH_IP_HEADER=x-forwarded-for
BETTER_AUTH_TRUSTED_PROXIES=replace-with-deployment-proxy-ip

# Server-only descending rollover keys. Each value is exactly 32 random bytes encoded
# as unpadded base64url. Retain old keys through the complete delivery-ledger retention
# window. The lease is 30-900 seconds and defaults to 300.
AUTH_EMAIL_IDEMPOTENCY_KEYS=1:replace-with-32-random-bytes-as-base64url
AUTH_EMAIL_IDEMPOTENCY_LEASE_SECONDS=300

# Selected SES v2 regional adapter. The sender identity and configuration set must be
# provisioned separately; these placeholders do not authorize or perform delivery.
SES_AUTH_EMAIL_REGION=ca-central-1
SES_AUTH_EMAIL_FROM=security@auth.replace.example
SES_AUTH_EMAIL_CONFIGURATION_SET=replace-authentication-events
SES_AUTH_EMAIL_FEEDBACK_TOPIC_ARN=arn:aws:sns:ca-central-1:000000000000:replace-authentication-feedback
SES_AUTH_EMAIL_IDENTITY_ARN=arn:aws:ses:ca-central-1:000000000000:identity/auth.replace.example
AUTH_EMAIL_FEEDBACK_KEYS=1:replace-with-32-byte-base64url-key

# Server-only Paddle notification destination secret. Required for the webhook route.
PADDLE_WEBHOOK_SECRET=

# Canonical comma-separated Paddle price IDs; never prefix these variables NEXT_PUBLIC_.
PADDLE_PERSONAL_PRICE_REFERENCES=
PADDLE_ADVANCED_PRICE_REFERENCES=
